{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-code-review",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*", "/webhook/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "RepoAgent", "class_name": "RepoAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoAgent"] }],
  "workflows": [
    { "name": "review-workflow", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }
  ],
  "vars": {
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "REVIEW_ON_PUSH": "true",
    "MAX_INLINE_COMMENTS": "20",
    "MIN_CONFIDENCE": "0.5"
  },
  "observability": { "enabled": true }
}
